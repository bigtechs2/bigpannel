bigpannel/
├── .env.example                 # Environment variables (BUSINESS_PHONE=255636756591, Stripe keys, etc.)
├── .gitignore                   # Node modules, .env, logs
├── package.json                 # Dependencies & scripts
├── render.yaml                  # Render Blueprint for zero-click deploy
├── server.js                    # Main Express entry point (serves API + static frontend)
│
├── prisma/
│   ├── schema.prisma            # ALL 12 database models (Users, Plans, Orders, Servers...)
│   └── seed.js                  # Seeds the first SUPER_ADMIN user
│
└── src/
    ├── frontend/                # All public-facing HTML/CSS/JS (Black-Grey + Emerald theme)
    │   ├── index.html           # Landing page
    │   ├── login.html           # Login page
    │   ├── register.html        # Registration page
    │   ├── dashboard.html       # Customer dashboard (view servers, buy, tickets)
    │   ├── server-manager.html  # Full server control (console, files, start/stop)
    │   ├── admin.html           # Admin panel (users, plans, revenue, logs)
    │   ├── css/
    │   │   └── style.css        # Global styles (#0B0C10, #1A1C23, #10B981)
    │   └── js/
    │       ├── api.js           # Centralized fetch calls to backend API
    │       ├── auth.js          # JWT handling, login/register logic
    │       └── dashboard.js     # Dynamic UI updates (statistics, server cards)
    │
    └── backend/                 # Pure Node.js / Express logic
        ├── config/
        │   └── index.js         # Centralized env vars & constants
        ├── middleware/
        │   ├── auth.js          # JWT verification middleware
        │   ├── rateLimit.js     # Rate limiting (free tier friendly)
        │   └── validation.js    # Input sanitization & validation
        ├── services/
        │   ├── paymentService.js# Abstracted payment class (Stripe + Mobile Money mock)
        │   ├── stripeService.js # Stripe specific (Visa/Mastercard setup)
        │   ├── pterodactylService.js # All Pterodactyl API calls (create, start, stop, etc.)
        │   └── emailService.js  # Transactional emails via Resend
        ├── routes/
        │   ├── authRoutes.js    # Register, Login, Forgot Password
        │   ├── serverRoutes.js  # Server management (CRUD, controls, console)
        │   ├── paymentRoutes.js # Checkout, webhooks
        │   ├── adminRoutes.js   # Admin stats, user management, plans
        │   └── ticketRoutes.js  # Support tickets
        └── utils/
            ├── logger.js        # Logging utility (writes to console & logs/ folder)
            └── helpers.js       # Reusable helpers (pagination, date formatting)